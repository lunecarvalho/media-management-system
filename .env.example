SECRET_KEY=sua-chave-secreta-muito-segura-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados
# Opção 1: deixe tudo comentado para usar SQLite (padrão em desenvolvimento local)
# Opção 2: preencha DB_* para usar PostgreSQL local/Docker
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=mediatrack
# DB_USER=postgres
# DB_PASSWORD=sua-senha-postgres
# DB_HOST=localhost
# DB_PORT=5432
# Opção 3 (produção/Render/Supabase): defina apenas DATABASE_URL, tem prioridade sobre as anteriores
# DATABASE_URL=postgresql://usuario:senha@host:porta/nome-do-banco

# CORS e CSRF (produção)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://seu-dominio.onrender.com

# Segurança (produção, DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Chaves de API (inicialmente vazias, serão adicionadas depois)
MUSICBRAINZ_API_URL=https://musicbrainz.org/ws/2/
TMDB_API_KEY=your-api-key-here

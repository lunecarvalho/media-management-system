# Desenvolvimento somente. Producao: DEBUG=False e chave aleatoria com 50+ caracteres.
DEBUG=True
SECRET_KEY=django-insecure-development-only
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/mediatrack
# RDS: sslmode=verify-full e sslrootcert apontando para o bundle de CA.
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HEADERS=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
MUSICBRAINZ_USER_AGENT=MediaTrack/1.0 (configure-um-contato-real)
# Opcional: caminho local para movies_metadata.csv; nunca versionar o dataset.
MOVIES_DATASET_PATH=
